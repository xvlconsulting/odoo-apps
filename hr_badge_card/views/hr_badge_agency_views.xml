<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_badge_agency_view_list" model="ir.ui.view">
        <field name="name">hr.badge.agency.list</field>
        <field name="model">hr.badge.agency</field>
        <field name="arch" type="xml">
            <list string="Badge Agencies">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="employee_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="hr_badge_agency_view_form" model="ir.ui.view">
        <field name="name">hr.badge.agency.form</field>
        <field name="model">hr.badge.agency</field>
        <field name="arch" type="xml">
            <form string="Badge Agency">
                <sheet>
                    <field name="logo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name" string="Label"/>
                        <h1><field name="name" placeholder="e.g. Paris Office"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        The label is printed on the front of the badge, the logo in the top
                        right corner, and the phone number in the contact block.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_badge_agency_action" model="ir.actions.act_window">
        <field name="name">Badge Agencies</field>
        <field name="res_model">hr.badge.agency</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first badge agency</p>
            <p>
                An agency carries a label, a logo and a phone number. Assign it to your
                employees and their badges are branded accordingly.
            </p>
        </field>
    </record>

    <menuitem id="hr_badge_agency_menu"
              name="Badge Agencies"
              parent="hr.menu_human_resources_configuration"
              action="hr_badge_agency_action"
              sequence="95"
              groups="hr.group_hr_manager"/>

</odoo>
